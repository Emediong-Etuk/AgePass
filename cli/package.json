{
  "name": "@agepass/cli",
  "version": "0.1.0",
  "description": "AgePass command-line tools and scripted local demo",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "agepass": "./dist/index.js"
  },
  "scripts": {
    "agepass": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "e2e": "tsx src/demo.ts --assert",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agepass/contract": "0.1.0",
    "@agepass/sdk": "0.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "commander": "14.0.2",
    "dotenv": "17.2.3",
    "rxjs": "7.8.2",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
