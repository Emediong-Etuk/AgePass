{
  "extends": "../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", "vite.config.ts"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "allowJs": true,
    "paths": {
      "@agepass/contract": ["../contract/src/index.ts"],
      "@agepass/sdk": ["../sdk/src/index.ts"]
    }
  }
}
