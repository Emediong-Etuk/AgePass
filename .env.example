# AgePass environment. Copy to `.env` (gitignored) and fill in locally.
# NEVER commit real seeds, mnemonics or tokens.

# Which network the CLI talks to: undeployed (local devnet) | preview | preprod
AGEPASS_NETWORK=undeployed

# Hex wallet seed for the CLI wallet that pays fees (deploy, issue, prove).
# Leave empty on `undeployed`: the CLI uses the local devnet's pre-funded genesis seed.
AGEPASS_WALLET_SEED=

# Password that encrypts AgePass private state on disk (level private-state provider).
# Rules: 16+ characters, at least 3 of {lower, upper, digit, symbol},
# no character repeated 4 times in a row, no 4-character ascending/descending run.
AGEPASS_PRIVATE_STATE_PASSWORD=

# Contract address after `agepass deploy` (the CLI also remembers it in .agepass/).
AGEPASS_CONTRACT_ADDRESS=

# Only for preprod: Blockfrost Midnight Preprod project ID (starts with `nightpreprod`).
BLOCKFROST_PROJECT_ID=

# Proof server (always local; run `npm run devnet:up` or the proof-server container)
AGEPASS_PROOF_SERVER=http://localhost:6300
